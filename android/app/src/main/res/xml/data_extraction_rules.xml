<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) backup and data extraction rules.
    No cloud backup or device transfer is allowed (mirrors allowBackup="false").
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
    </device-transfer>
</data-extraction-rules>
