{
    "name": "OptMsg",
    "short_name": "OptMsg",
    "start_url": ".",
    "display": "standalone",
    "theme_color": "#2748C3",
    "background_color": "#FFFFFF",
    "description": "OptMsg is a cross-platform application for private, secure, opt-in email and messaging. Built with a privacy-first approach, it gives users control over who can contact them while delivering a fast, modern experience across iOS, Android, and Web.",
    "orientation": "portrait-primary",
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "assets/assets/icons/Icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "assets/assets/icons/Icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "assets/assets/icons/Icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "assets/assets/icons/Icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "protocol_handlers": [
        {
            "protocol": "mailto",
            "url": "/compose?to=%s"
        }
    ]
}